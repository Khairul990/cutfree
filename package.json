{
  "name": "cutfree-studio",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:vite": "vite --host 0.0.0.0 --port 5173",
    "dev:all": "concurrently \"tsx server.ts\" \"vite --host 0.0.0.0 --port 5173\"",
    "build": "node tools/build.js",
    "build:vite": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node tests/e2e.cjs",
    "test:studio": "node tests/studio.e2e.cjs",
    "test:all": "node tests/e2e.cjs && node tests/factory.e2e.cjs && node tests/studio.e2e.cjs",
    "test:single": "PAGE=cutfree-studio-pro.html node tests/studio.e2e.cjs",
    "test:factory": "node tests/factory.e2e.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "playwright": "^1.56.0"
  }
}
